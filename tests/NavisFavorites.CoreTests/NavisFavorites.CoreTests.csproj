<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>NavisFavorites.CoreTests</AssemblyName>
    <NavisworksInstallDir Condition="'$(NavisworksInstallDir)' == ''">E:\auto\Navisworks Manage 2024</NavisworksInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(NavisworksInstallDir)\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\NavisFavorites\Models\*.cs" Link="Core\Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\NavisFavorites\Storage\*.cs" Link="Core\Storage\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\NavisFavorites\UI\MultiSelectionLogic.cs" Link="Core\MultiSelectionLogic.cs" />
  </ItemGroup>
</Project>
